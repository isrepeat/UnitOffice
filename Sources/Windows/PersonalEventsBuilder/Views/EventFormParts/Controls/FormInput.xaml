<UserControl x:Class="PersonalEventsBuilder.Views.EventFormParts.Controls.FormInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             UseSystemFocusVisuals="False"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:PersonalEventsBuilder.Controls"
             IsTabStop="False">
    <Grid Margin="3">
        <Rectangle Style="{x:Bind FieldStyle}" />
        <Border x:Name="HoverLayer"
                OpacityTransition="{StaticResource HoverTransition}"
                Style="{StaticResource HoverLayerStyle}" />
        <controls:PlaceholderLines Margin="8,0"
                                   LineWidths="33" />
        <Border x:Name="FocusFrame"
                Style="{StaticResource ActiveEntityFrameStyle}"
                Visibility="Collapsed" />
    </Grid>
</UserControl>
<UserControl x:Class="PersonalEventsBuilder.Views.EventFormParts.FormInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             UseSystemFocusVisuals="False"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsTabStop="False">
    <Grid Margin="3">
        <Rectangle Style="{x:Bind FieldStyle}" />
        <TextBlock Margin="8,0"
                   VerticalAlignment="Center"
                   Foreground="White"
                   Text="{x:Bind Label}"
                   TextTrimming="CharacterEllipsis" />
        <Border x:Name="FocusFrame"
                Style="{StaticResource ActiveEntityFrameStyle}"
                Visibility="Collapsed" />
    </Grid>
</UserControl>
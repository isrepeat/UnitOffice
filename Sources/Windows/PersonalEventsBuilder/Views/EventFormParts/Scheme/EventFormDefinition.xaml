<scheme:FormDefinition x:Class="PersonalEventsBuilder.Views.EventFormParts.Scheme.EventFormDefinition"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:scheme="using:PersonalEventsBuilder.Views.EventFormParts.Scheme">
    <scheme:FormDefinition.Modes>
        <scheme:FormModeDefinition Mode="Arrival1"
                                   Features="Document" />
        <scheme:FormModeDefinition Mode="Arrival2"
                                   Features="Treatment" />
        <scheme:FormModeDefinition Mode="Arrival3"
                                   Features="Document,Treatment" />
    </scheme:FormDefinition.Modes>
    <scheme:FormGroup Column="2"
                      LabelKey="Tr_FormPrimary"
                      Placement="Primary">
        <scheme:FormField Id="A1"
                          Width="3" />
        <scheme:FormField Id="A2"
                          Width="2" />
        <scheme:FormField Id="A3"
                          Width="2" />
        <scheme:FormField Id="A4"
                          Width="2" />
    </scheme:FormGroup>
    <scheme:FormGroup Feature="Document"
                      LabelKey="Tr_FormExtension"
                      Placement="Left">
        <scheme:FormField Id="L1"
                          Width="1" />
        <scheme:FormField Id="L2"
                          Width="1" />
    </scheme:FormGroup>
    <scheme:FormGroup Feature="Treatment"
                      LabelKey="Tr_FormExtension"
                      Placement="Right">
        <scheme:FormField Id="R1"
                          Width="1" />
        <scheme:FormField Id="R2"
                          Width="1" />
    </scheme:FormGroup>
    <scheme:FormGroup Feature="Document"
                      LabelKey="Tr_FormExtension"
                      Placement="BelowField"
                      AnchorFieldId="A1">
        <scheme:FormField Id="B1"
                          Width="3" />
        <scheme:FormField Id="B2"
                          Width="3" />
    </scheme:FormGroup>
    <scheme:FormGroup Feature="Treatment"
                      LabelKey="Tr_FormExtension"
                      Placement="BelowField"
                      AnchorFieldId="A3">
        <scheme:FormField Id="C1"
                          Width="2" />
        <scheme:FormField Id="C2"
                          Width="2" />
    </scheme:FormGroup>
    <scheme:FormGroup Feature="Document,Treatment"
                      LabelKey="Tr_FormExtension"
                      Placement="BelowField"
                      AnchorFieldId="A1">
        <scheme:FormField Id="D1"
                          Width="2" />
        <scheme:FormField Id="D2"
                          Width="2" />
        <scheme:FormField Id="D3"
                          Width="2" />
    </scheme:FormGroup>
</scheme:FormDefinition>
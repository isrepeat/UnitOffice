<UserControl x:Class="PersonalEventsBuilder.Views.PaletteEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="12"
          RowSpacing="8"
          RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Uid="Tr_PaletteTitle"
                       VerticalAlignment="Center"
                       Style="{StaticResource SubtitleTextBlockStyle}" />
            <Button x:Uid="Tr_PaletteClose"
                    x:Name="CloseButton"
                    Grid.Column="1"
                    Click="OnClose" />
        </Grid>
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
                <ComboBox x:Uid="Tr_PaletteProfiles"
                          x:Name="Profiles"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="OnProfileChanged" />
                <Grid ColumnSpacing="6"
                      ColumnDefinitions="*,Auto">
                    <TextBox x:Uid="Tr_PaletteName"
                             x:Name="ProfileName"
                             MaxLength="48"
                             TextChanged="OnNameChanged" />
                    <Button x:Uid="Tr_PaletteCreate"
                            x:Name="CreateButton"
                            Grid.Column="1"
                            Click="OnCreate"
                            IsEnabled="False" />
                </Grid>
                <ComboBox x:Uid="Tr_PaletteScheme"
                          x:Name="Scheme"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="OnSchemeChanged">
                    <ComboBoxItem x:Uid="Tr_PaletteWarm"
                                  Tag="warm" />
                    <ComboBoxItem x:Uid="Tr_PaletteGraphite"
                                  Tag="graphite" />
                    <ComboBoxItem x:Uid="Tr_PaletteSlate"
                                  Tag="slate" />
                </ComboBox>
                <Slider x:Uid="Tr_PaletteBrightness"
                        x:Name="Brightness"
                        Maximum="35"
                        Minimum="-20"
                        ValueChanged="OnToneChanged" />
                <Slider x:Uid="Tr_PaletteDifference"
                        x:Name="Difference"
                        Maximum="24"
                        ValueChanged="OnToneChanged" />
                <Slider x:Uid="Tr_PaletteLines"
                        x:Name="Lines"
                        Maximum="55"
                        ValueChanged="OnToneChanged" />
                <TextBlock x:Uid="Tr_PaletteResources"
                           Margin="0,8,0,0"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Grid ColumnSpacing="8"
                      ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="BrushNames"
                               IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="BrushValues"
                               Grid.Column="1"
                               FontFamily="Consolas"
                               IsTextSelectionEnabled="True" />
                </Grid>
                <Button x:Uid="Tr_PaletteReset"
                        Click="OnReset" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
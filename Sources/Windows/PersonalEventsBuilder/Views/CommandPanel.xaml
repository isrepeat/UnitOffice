<UserControl x:Class="PersonalEventsBuilder.Views.CommandPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:parts="using:PersonalEventsBuilder.Views.CommandPanelParts"
             xmlns:controls="using:PersonalEventsBuilder.Controls"
             IsTabStop="False">
    <Grid Margin="4"
          RowSpacing="3"
          RowDefinitions="Auto,*"
          ColumnDefinitions="*,Auto">
        <Grid ColumnSpacing="6"
              Grid.ColumnSpan="2"
              ColumnDefinitions="*,*,*">
            <TextBlock Foreground="{StaticResource WorkspaceTextBrush}"
                       Text="Прибытие" />
            <TextBlock Grid.Column="1"
                       Foreground="{StaticResource WorkspaceTextBrush}"
                       Text="Убытие" />
            <TextBlock Grid.Column="2"
                       Foreground="{StaticResource WorkspaceTextBrush}"
                       Text="Изменение статуса" />
        </Grid>
        <ScrollViewer x:Name="CommandViewport" Grid.Row="1"
                      HorizontalContentAlignment="Stretch"
                      VerticalScrollMode="Disabled"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">
            <parts:CommandGrid x:Name="Buttons"
                               RowSpacing="3"
                               ColumnSpacing="4"
                               RowDefinitions="36,36,36,36"
                               ColumnDefinitions="2*,2*,*,*">
                <controls:PlaceholderButton Grid.Row="0"
                                            Grid.Column="0"
                                            Command="{Binding SelectModeCommand}"
                                            CommandParameter="Arrival1" />
                <controls:PlaceholderButton Grid.Row="1"
                                            Grid.Column="0"
                                            Command="{Binding SelectModeCommand}"
                                            CommandParameter="Arrival2" />
                <controls:PlaceholderButton Grid.Row="2"
                                            Grid.Column="0"
                                            Command="{Binding SelectModeCommand}"
                                            CommandParameter="Arrival3" />
                <controls:PlaceholderButton Grid.Row="3"
                                            Grid.Column="0"
                                            Command="{Binding SelectModeCommand}"
                                            CommandParameter="Arrival4" />
                <controls:PlaceholderButton Grid.Row="0"
                                            Grid.Column="1"
                                            Command="{Binding SelectModeCommand}"
                                            CommandParameter="Departure1" />
                <controls:PlaceholderButton Grid.Row="1"
                                            Grid.Column="1"
                                            Command="{Binding SelectModeCommand}"
                                            CommandParameter="Departure2" />
                <controls:PlaceholderButton Grid.Row="2"
                                            Grid.Column="1"
                                            Command="{Binding SelectModeCommand}"
                                            CommandParameter="Departure3" />
                <controls:PlaceholderButton Grid.Row="3"
                                            Grid.Column="1"
                                            Command="{Binding SelectModeCommand}"
                                            CommandParameter="Departure4" />
                <controls:PlaceholderButton Grid.Row="0"
                                            Grid.Column="2"
                                            Grid.RowSpan="2"
                                            Height="Auto"
                                            Command="{Binding SelectModeCommand}"
                                            CommandParameter="ExtendMedicalLeave"
                                            PlaceholderLines_LineWidths="33,57" />
                <controls:PlaceholderButton Grid.Row="0"
                                            Grid.Column="3"
                                            Grid.RowSpan="2"
                                            Height="Auto"
                                            Command="{Binding SelectModeCommand}"
                                            CommandParameter="TreatmentToMedicalLeave"
                                            PlaceholderLines_LineWidths="33,57" />
                <controls:PlaceholderButton Grid.Row="2"
                                            Grid.Column="2"
                                            Grid.RowSpan="2"
                                            Height="Auto"
                                            Command="{Binding SelectModeCommand}"
                                            CommandParameter="MedicalLeaveToHospital"
                                            PlaceholderLines_LineWidths="33,57" />
                <controls:PlaceholderButton Grid.Row="2"
                                            Grid.Column="3"
                                            Grid.RowSpan="2"
                                            Height="Auto"
                                            Command="{Binding SelectModeCommand}"
                                            CommandParameter="AbsenceToAssignment"
                                            PlaceholderLines_LineWidths="33,57" />
            </parts:CommandGrid>
        </ScrollViewer>
        <ScrollBar Grid.Row="1" Grid.Column="1"
                   IsTabStop="False"
                   Orientation="Vertical"
                   Visibility="{x:Bind ScrollVisibility(CommandViewport.ScrollableHeight), Mode=OneWay}"
                   Maximum="{Binding ScrollableHeight, ElementName=CommandViewport}"
                   ViewportSize="{Binding ViewportHeight, ElementName=CommandViewport}"
                   Value="{Binding VerticalOffset, ElementName=CommandViewport, Mode=OneWay}"
                   Scroll="OnCommandScroll" />
    </Grid>
</UserControl>
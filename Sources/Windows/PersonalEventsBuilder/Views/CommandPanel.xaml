<UserControl x:Class="PersonalEventsBuilder.Views.CommandPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:PersonalEventsBuilder.Controls"
             xmlns:parts="using:PersonalEventsBuilder.Views.CommandPanelParts"
             IsTabStop="False">
    <Grid Margin="4"
          RowDefinitions="Auto,*"
          RowSpacing="3">
        <Grid ColumnDefinitions="*,*,*"
              ColumnSpacing="6">
            <TextBlock Foreground="{StaticResource WorkspaceTextBrush}"
                   Text="Прибытие" />
            <TextBlock Foreground="{StaticResource WorkspaceTextBrush}"
                   Grid.Column="1"
                       Text="Убытие" />
            <TextBlock Foreground="{StaticResource WorkspaceTextBrush}"
                   Grid.Column="2"
                       Text="Изменение статуса" />
        </Grid>
        <ScrollViewer Grid.Row="1"
                      HorizontalContentAlignment="Stretch"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Hidden">
            <parts:CommandGrid x:Name="Buttons"
                                RowDefinitions="36,36,36,36"
                                ColumnDefinitions="2*,2*,*,*"
                                RowSpacing="3"
                                ColumnSpacing="4">
                <controls:PlaceholderButton x:Uid="Tr_PlaceholderButton1"
                                            Grid.Row="0"
                                            Grid.Column="0" />
                <controls:PlaceholderButton x:Uid="Tr_PlaceholderButton2"
                                            Grid.Row="1"
                                            Grid.Column="0" />
                <controls:PlaceholderButton x:Uid="Tr_PlaceholderButton3"
                                            Grid.Row="2"
                                            Grid.Column="0" />
                <controls:PlaceholderButton x:Uid="Tr_PlaceholderButton4"
                                            Grid.Row="3"
                                            Grid.Column="0" />
                <controls:PlaceholderButton x:Uid="Tr_PlaceholderButton1"
                                            Grid.Row="0"
                                            Grid.Column="1" />
                <controls:PlaceholderButton x:Uid="Tr_PlaceholderButton2"
                                            Grid.Row="1"
                                            Grid.Column="1" />
                <controls:PlaceholderButton x:Uid="Tr_PlaceholderButton3"
                                            Grid.Row="2"
                                            Grid.Column="1" />
                <controls:PlaceholderButton x:Uid="Tr_PlaceholderButton4"
                                            Grid.Row="3"
                                            Grid.Column="1" />
                <controls:PlaceholderButton Grid.Row="0"
                                            Grid.Column="2"
                                            Grid.RowSpan="2"
                                            PlaceholderLines_LineWidths="33,57"
                                            Height="Auto">
                    <TextBlock x:Uid="Tr_ExtendMedicalLeave"
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </controls:PlaceholderButton>
                <controls:PlaceholderButton Grid.Row="0"
                                            Grid.Column="3"
                                            Grid.RowSpan="2"
                                            PlaceholderLines_LineWidths="33,57"
                                            Height="Auto">
                    <TextBlock x:Uid="Tr_TreatmentToMedicalLeave"
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </controls:PlaceholderButton>
                <controls:PlaceholderButton Grid.Row="2"
                                            Grid.Column="2"
                                            Grid.RowSpan="2"
                                            PlaceholderLines_LineWidths="33,57"
                                            Height="Auto">
                    <TextBlock x:Uid="Tr_MedicalLeaveToHospital"
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </controls:PlaceholderButton>
                <controls:PlaceholderButton Grid.Row="2"
                                            Grid.Column="3"
                                            Grid.RowSpan="2"
                                            PlaceholderLines_LineWidths="33,57"
                                            Height="Auto">
                    <TextBlock x:Uid="Tr_AbsenceToAssignment"
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </controls:PlaceholderButton>
            </parts:CommandGrid>
        </ScrollViewer>
    </Grid>
</UserControl>
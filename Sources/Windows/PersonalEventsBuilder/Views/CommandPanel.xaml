<UserControl x:Class="PersonalEventsBuilder.Views.CommandPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:parts="using:PersonalEventsBuilder.Views.CommandPanelParts"
             xmlns:controls="using:PersonalEventsBuilder.Controls"
             IsTabStop="False">
    <Grid Margin="4"
          RowSpacing="3"
          RowDefinitions="Auto,*">
        <Grid ColumnSpacing="6"
              ColumnDefinitions="*,*,*">
            <TextBlock Foreground="{StaticResource WorkspaceTextBrush}"
                       Text="Прибытие" />
            <TextBlock Grid.Column="1"
                       Foreground="{StaticResource WorkspaceTextBrush}"
                       Text="Убытие" />
            <TextBlock Grid.Column="2"
                       Foreground="{StaticResource WorkspaceTextBrush}"
                       Text="Изменение статуса" />
        </Grid>
        <ScrollViewer Grid.Row="1"
                      HorizontalContentAlignment="Stretch"
                      VerticalScrollMode="Enabled"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">
            <parts:CommandGrid x:Name="Buttons"
                               RowSpacing="3"
                               ColumnSpacing="4"
                               RowDefinitions="36,36,36,36"
                               ColumnDefinitions="2*,2*,*,*">
                <controls:PlaceholderButton x:Uid="Tr_PlaceholderButton1"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Command="{Binding SelectModeCommand}"
                                            CommandParameter="Arrival1" />
                <controls:PlaceholderButton x:Uid="Tr_PlaceholderButton2"
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Command="{Binding SelectModeCommand}"
                                            CommandParameter="Arrival2" />
                <controls:PlaceholderButton x:Uid="Tr_PlaceholderButton3"
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Command="{Binding SelectModeCommand}"
                                            CommandParameter="Arrival3" />
                <controls:PlaceholderButton x:Uid="Tr_PlaceholderButton4"
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Command="{Binding SelectModeCommand}"
                                            CommandParameter="Arrival4" />
                <controls:PlaceholderButton x:Uid="Tr_PlaceholderButton1"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Command="{Binding SelectModeCommand}"
                                            CommandParameter="Departure1" />
                <controls:PlaceholderButton x:Uid="Tr_PlaceholderButton2"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Command="{Binding SelectModeCommand}"
                                            CommandParameter="Departure2" />
                <controls:PlaceholderButton x:Uid="Tr_PlaceholderButton3"
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Command="{Binding SelectModeCommand}"
                                            CommandParameter="Departure3" />
                <controls:PlaceholderButton x:Uid="Tr_PlaceholderButton4"
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Command="{Binding SelectModeCommand}"
                                            CommandParameter="Departure4" />
                <controls:PlaceholderButton Grid.Row="0"
                                            Grid.Column="2"
                                            Grid.RowSpan="2"
                                            Height="Auto"
                                            Command="{Binding SelectModeCommand}"
                                            CommandParameter="ExtendMedicalLeave"
                                            PlaceholderLines_LineWidths="33,57">
                    <TextBlock x:Uid="Tr_ExtendMedicalLeave"
                               FontSize="12"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </controls:PlaceholderButton>
                <controls:PlaceholderButton Grid.Row="0"
                                            Grid.Column="3"
                                            Grid.RowSpan="2"
                                            Height="Auto"
                                            Command="{Binding SelectModeCommand}"
                                            CommandParameter="TreatmentToMedicalLeave"
                                            PlaceholderLines_LineWidths="33,57">
                    <TextBlock x:Uid="Tr_TreatmentToMedicalLeave"
                               FontSize="12"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </controls:PlaceholderButton>
                <controls:PlaceholderButton Grid.Row="2"
                                            Grid.Column="2"
                                            Grid.RowSpan="2"
                                            Height="Auto"
                                            Command="{Binding SelectModeCommand}"
                                            CommandParameter="MedicalLeaveToHospital"
                                            PlaceholderLines_LineWidths="33,57">
                    <TextBlock x:Uid="Tr_MedicalLeaveToHospital"
                               FontSize="12"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </controls:PlaceholderButton>
                <controls:PlaceholderButton Grid.Row="2"
                                            Grid.Column="3"
                                            Grid.RowSpan="2"
                                            Height="Auto"
                                            Command="{Binding SelectModeCommand}"
                                            CommandParameter="AbsenceToAssignment"
                                            PlaceholderLines_LineWidths="33,57">
                    <TextBlock x:Uid="Tr_AbsenceToAssignment"
                               FontSize="12"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </controls:PlaceholderButton>
            </parts:CommandGrid>
        </ScrollViewer>
    </Grid>
</UserControl>
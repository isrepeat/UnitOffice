<UserControl x:Class="PersonalEventsBuilder.Views.WordPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:PersonalEventsBuilder.Controls"
             IsTabStop="False">
    <Grid Margin="7"
          RowSpacing="4"
          RowDefinitions="Auto,*">
        <TextBlock x:Uid="Tr_WordPreviewHeading"
                   HorizontalAlignment="Left"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource WorkspaceTextBrush}" />
        <Border Grid.Row="1"
                Padding="10"
                Background="{StaticResource WorkspaceDeepBrush}"
                BorderBrush="{StaticResource GridLineBrush}"
                BorderThickness="1">
            <controls:PlaceholderLines VerticalAlignment="Top"
                                       LineWidths="30,55" />
        </Border>
    </Grid>
</UserControl>
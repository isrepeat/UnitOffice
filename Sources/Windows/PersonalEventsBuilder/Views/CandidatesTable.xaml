<UserControl x:Class="PersonalEventsBuilder.Views.CandidatesTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:grid="using:UDK.WinUI.Grid">
    <Grid Margin="0,6"
          RowSpacing="4"
          RowDefinitions="Auto,*,Auto">
        <TextBlock x:Uid="Tr_CandidatesHeading"
                   Foreground="{StaticResource WorkspaceTextBrush}"
                   HorizontalAlignment="Left"
                   FontWeight="SemiBold" />
        <grid:GridCanvas x:Name="Surface"
                          Grid.Row="1"
                          GridLinesVisibility="Collapsed"
                          GridLayout="{x:Bind GridLayout, Mode=OneWay}" />
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
            <Button x:Name="Previous"
                    Content="←"
                    Click="OnPrevious" />
            <Button x:Name="Next"
                    Content="→"
                    Click="OnNext" />
        </StackPanel>
    </Grid>
</UserControl>
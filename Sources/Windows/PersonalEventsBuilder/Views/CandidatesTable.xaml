<UserControl x:Class="PersonalEventsBuilder.Views.CandidatesTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:grid="using:UDK.WinUI.Grid">
    <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Foreground="{StaticResource WorkspaceTextBrush}"
                   Text="Таблица кандидатов" />
        <grid:GridCanvas x:Name="Surface"
                          Grid.Row="1"
                          GridLayout="{x:Bind GridLayout, Mode=OneWay}" />
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
            <Button x:Name="Previous"
                    Content="←"
                    Click="OnPrevious" />
            <Button x:Name="Next"
                    Content="→"
                    Click="OnNext" />
        </StackPanel>
    </Grid>
</UserControl>
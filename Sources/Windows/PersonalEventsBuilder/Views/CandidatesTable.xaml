<UserControl x:Class="PersonalEventsBuilder.Views.CandidatesTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:udkGridControls="using:UDK.WinUI.Grid.Controls"
             xmlns:candidatesTableControls="using:PersonalEventsBuilder.Views.CandidatesTableParts.Controls">
    <Grid Margin="0,6"
          RowSpacing="4"
          RowDefinitions="Auto,*">
        <TextBlock x:Uid="Tr_CandidatesHeading"
                   HorizontalAlignment="Left"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource WorkspaceTextBrush}" />
        <udkGridControls:GridCanvas Grid.Row="1"
                                    GridLayout="{x:Bind GridLayout, Mode=OneWay}"
                                    GridLinesVisibility="Visible"
                                    ItemsSource="{x:Bind TableItems, Mode=OneTime}">
            <udkGridControls:GridCanvas.ItemTemplate>
                <DataTemplate x:DataType="candidatesTableControls:CandidateTableItem">
                    <candidatesTableControls:CandidateGrid TableItem="{x:Bind}" />
                </DataTemplate>
            </udkGridControls:GridCanvas.ItemTemplate>
        </udkGridControls:GridCanvas>
    </Grid>
</UserControl>
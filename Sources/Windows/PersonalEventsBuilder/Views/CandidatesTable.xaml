<UserControl x:Class="PersonalEventsBuilder.Views.CandidatesTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:udkGridControls="using:UDK.WinUI.Grid.Controls"
             xmlns:candidatesTableControls="using:PersonalEventsBuilder.Views.CandidatesTableParts.Controls">
    <Grid Margin="0,6"
          RowSpacing="4"
          RowDefinitions="Auto,*,Auto">
        <TextBlock x:Uid="Tr_CandidatesHeading"
                   HorizontalAlignment="Left"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource WorkspaceTextBrush}" />
        <udkGridControls:GridCanvas x:Name="Surface"
                                    Grid.Row="1"
                                    GridLayout="{x:Bind GridLayout, Mode=OneWay}"
                                    GridLinesVisibility="Visible"
                                    ItemsSource="{x:Bind GetTableItems(Columns, Rows), Mode=OneWay}">
            <udkGridControls:GridCanvas.ItemTemplate>
                <DataTemplate>
                    <candidatesTableControls:CandidateGrid />
                </DataTemplate>
            </udkGridControls:GridCanvas.ItemTemplate>
        </udkGridControls:GridCanvas>
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
            <Button x:Name="Previous"
                    Click="OnPrevious"
                    Content="←" />
            <Button x:Name="Next"
                    Click="OnNext"
                    Content="→" />
        </StackPanel>
    </Grid>
</UserControl>
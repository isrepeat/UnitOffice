<UserControl x:Class="PersonalEventsBuilder.Views.CandidatesTableParts.CandidateCell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             UseSystemFocusVisuals="False"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False"
             IsTabStop="False">
    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource GridLineBrush}"
            BorderThickness="0.5">
        <Grid>
            <TextBlock Margin="5,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Text="{Binding}"
                       TextTrimming="CharacterEllipsis" />
            <Border x:Name="FocusFrame"
                    Style="{StaticResource ActiveEntityFrameStyle}"
                    Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
<UserControl x:Class="PersonalEventsBuilder.Views.CandidatesTableParts.Controls.CandidateCell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             UseSystemFocusVisuals="False"
             xmlns:controls="using:PersonalEventsBuilder.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False"
             IsTabStop="False">
    <Border x:Name="Surface"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource GridLineBrush}"
            BorderThickness="0.5">
        <Grid>
            <controls:PlaceholderLines x:Name="Stroke"
                                       Margin="16,0"
                                       LineWidths="33"
                                       Visibility="Collapsed"
                                       AutomationProperties.Name="{Binding}" />
            <Border x:Name="FocusFrame"
                    Style="{StaticResource ActiveEntityFrameStyle}"
                    Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
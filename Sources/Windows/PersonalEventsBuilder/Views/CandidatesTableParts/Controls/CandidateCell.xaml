<UserControl x:Class="PersonalEventsBuilder.Views.CandidatesTableParts.Controls.CandidateCell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:PersonalEventsBuilder.Controls"
             IsTabStop="False"
             IsHitTestVisible="False"
             UseSystemFocusVisuals="False">
    <Border x:Name="Surface"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource GridLineBrush}"
            BorderThickness="0.5">
        <Grid>
            <Grid Visibility="{Binding PlaceholderVisibility, Source={StaticResource WorkspaceContentMode}}">
                <controls:PlaceholderLines Margin="16,0"
                                           LineWidths="33"
                                           Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                                           AutomationProperties.Name="{Binding Value}" />
            </Grid>
            <TextBlock Margin="16,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource WorkspaceTextBrush}"
                       Text="{Binding Value}"
                       Visibility="{Binding DataVisibility, Source={StaticResource WorkspaceContentMode}}"
                       TextTrimming="CharacterEllipsis" />
            <Border x:Name="FocusFrame"
                    Style="{StaticResource ActiveEntityFrameStyle}"
                    Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
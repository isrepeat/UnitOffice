<UserControl x:Class="PersonalEventsBuilder.Views.CandidatesTableParts.Controls.CandidateGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:candidatesTableControls="using:PersonalEventsBuilder.Views.CandidatesTableParts.Controls"
             IsTabStop="False"
             UseSystemFocusVisuals="False">
    <UserControl.Resources>
        <DataTemplate x:Key="CandidateCellTemplate">
            <candidatesTableControls:CandidateCell />
        </DataTemplate>
    </UserControl.Resources>
    <Canvas x:Name="Cells" />
</UserControl>
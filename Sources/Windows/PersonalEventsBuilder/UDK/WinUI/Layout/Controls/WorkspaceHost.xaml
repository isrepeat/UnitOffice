<UserControl x:Class="UDK.WinUI.Layout.Controls.WorkspaceHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Content>
        <Border x:Name="ZonePresenter">
            <Border.Resources>
                <DataTemplate x:Key="ScrollingRows">
                    <Grid RowDefinitions="*,Auto">
                        <ScrollViewer HorizontalContentAlignment="Stretch"
                                      HorizontalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      ZoomMode="Disabled" />
                        <StackPanel VerticalAlignment="Top"
                                    Margin="0,0,16,0" />
                        <ScrollBar Grid.Row="1"
                                   Orientation="Horizontal"
                                   IndicatorMode="MouseIndicator"
                                   AutomationProperties.AutomationId="SharedColumnScrollBar"
                                   IsTabStop="False"
                                   Visibility="Collapsed" />
                    </Grid>
                </DataTemplate>
                <DataTemplate x:Key="SectionHeader">
                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Visibility="Collapsed" />
                </DataTemplate>
                <DataTemplate x:Key="ZoneFrame">
                    <Border />
                </DataTemplate>
                <DataTemplate x:Key="ZoneGrid">
                    <Grid />
                </DataTemplate>
                <DataTemplate x:Key="Gap">
                    <Border Background="{StaticResource ZoneSplitterBrush}"
                            IsHitTestVisible="False" />
                </DataTemplate>
                <DataTemplate x:Key="DragHandle">
                    <Thumb MinWidth="0"
                           MinHeight="0"
                           VerticalAlignment="Stretch"
                           HorizontalAlignment="Stretch" />
                </DataTemplate>
            </Border.Resources>
        </Border>
    </UserControl.Content>
</UserControl>
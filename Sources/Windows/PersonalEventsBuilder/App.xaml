<Application x:Class="PersonalEventsBuilder.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="WorkspaceBackgroundBrush"
                             Color="#282521" />
            <SolidColorBrush x:Key="PanelBrush"
                             Color="#2D2A26" />
            <SolidColorBrush x:Key="WorkspaceDeepBrush"
                             Color="#201D19" />
            <SolidColorBrush x:Key="WorkspaceAccentBrush"
                             Color="#D9B287" />
            <SolidColorBrush x:Key="PrimaryFieldBrush"
                             Color="#383531" />
            <SolidColorBrush x:Key="LowerFieldBrush"
                             Color="#302D29" />
            <SolidColorBrush x:Key="SideFieldBrush"
                             Color="#403D39" />
            <SolidColorBrush x:Key="CommandBrush"
                             Color="#3C3935" />
            <SolidColorBrush x:Key="CommandHoverBrush"
                             Color="#46423D" />

            <Style x:Key="ActiveEntityFrameStyle"
                   TargetType="Border">
                <Setter Property="BorderBrush"
                        Value="{StaticResource WorkspaceAccentBrush}" />
                <Setter Property="BorderThickness"
                        Value="2" />
                <Setter Property="IsHitTestVisible"
                        Value="False" />
            </Style>
            <Style x:Key="WorkspacePageStyle"
                   TargetType="Page">
                <Setter Property="Background"
                        Value="{StaticResource WorkspaceBackgroundBrush}" />
                <Setter Property="RequestedTheme"
                        Value="Dark" />
            </Style>
            <Style x:Key="ZoneLabelStyle"
                   TargetType="TextBlock">
                <Setter Property="HorizontalAlignment"
                        Value="Center" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />
            </Style>
            <SolidColorBrush x:Key="GridLineBrush"
                             Color="#413E3A" />
            <SolidColorBrush x:Key="ZoneSplitterBrush"
                             Color="#33302C" />
            <SolidColorBrush x:Key="ZoneSplitterHoverBrush"
                             Color="#4A4743" />
            <Style x:Key="ZoneSplitterStyle"
                   TargetType="Thumb">
                <Setter Property="Background"
                        Value="{StaticResource ZoneSplitterBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="{TemplateBinding Background}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Highlight.Opacity"
                                                        Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Highlight.Opacity"
                                                        Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Highlight"
                                        Background="{StaticResource ZoneSplitterHoverBrush}"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ZonePanelStyle"
                   TargetType="Border">
                <Setter Property="Margin"
                        Value="5" />
                <Setter Property="Background"
                        Value="{StaticResource PanelBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
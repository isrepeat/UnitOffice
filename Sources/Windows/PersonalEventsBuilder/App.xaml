<Application x:Class="PersonalEventsBuilder.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:states="using:PersonalEventsBuilder.States"
             xmlns:convertors="using:PersonalEventsBuilder.Convertors">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <convertors:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <states:WorkspaceContentMode x:Key="WorkspaceContentMode" />
            <SolidColorBrush x:Key="WorkspaceBackgroundBrush"
                             Color="#28241F" />
            <SolidColorBrush x:Key="PanelBrush"
                             Color="#2D2924" />
            <SolidColorBrush x:Key="WorkspaceDeepBrush"
                             Color="#201C17" />
            <SolidColorBrush x:Key="WorkspaceAccentBrush"
                             Color="#D9B287" />
            <SolidColorBrush x:Key="PrimaryFieldBrush"
                             Color="#38332E" />
            <SolidColorBrush x:Key="LowerFieldBrush"
                             Color="#27221D" />
            <SolidColorBrush x:Key="SideFieldBrush"
                             Color="#49443F" />
            <SolidColorBrush x:Key="CommandBrush"
                             Color="#3E3934" />
            <SolidColorBrush x:Key="CommandTextBrush"
                             Color="#D9B287" />
            <SolidColorBrush x:Key="WorkspaceTextBrush"
                             Color="#D7D5D2" />
            <SolidColorBrush x:Key="HoverOverlayBrush"
                             Color="#0DFFFFFF" />
            <ScalarTransition x:Key="HoverTransition"
                              Duration="0:0:0.14" />
            <Style x:Key="HoverLayerStyle"
                   TargetType="Border">
                <Setter Value="{StaticResource HoverOverlayBrush}"
                        Property="Background" />
                <Setter Value="False"
                        Property="IsHitTestVisible" />
                <Setter Value="0"
                        Property="Opacity" />
            </Style>

            <Style x:Key="ActiveEntityFrameStyle"
                   TargetType="Border">
                <Setter Value="{StaticResource WorkspaceAccentBrush}"
                        Property="BorderBrush" />
                <Setter Value="2"
                        Property="BorderThickness" />
                <Setter Value="False"
                        Property="IsHitTestVisible" />
            </Style>
            <Style x:Key="WorkspacePageStyle"
                   TargetType="Page">
                <Setter Value="{StaticResource WorkspaceBackgroundBrush}"
                        Property="Background" />
                <Setter Value="{StaticResource WorkspaceTextBrush}"
                        Property="Foreground" />
                <Setter Value="Dark"
                        Property="RequestedTheme" />
            </Style>
            <Style x:Key="ZoneLabelStyle"
                   TargetType="TextBlock">
                <Setter Value="Center"
                        Property="HorizontalAlignment" />
                <Setter Value="Center"
                        Property="VerticalAlignment" />
            </Style>
            <SolidColorBrush x:Key="GridLineBrush"
                             Color="#3F3B36" />
            <SolidColorBrush x:Key="ZoneSplitterBrush"
                             Color="#332F2A" />
            <SolidColorBrush x:Key="ZoneSplitterHoverBrush"
                             Color="#4A4641" />
            <Style x:Key="ZoneSplitterStyle"
                   TargetType="Thumb">
                <Setter Value="{StaticResource ZoneSplitterBrush}"
                        Property="Background" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="{TemplateBinding Background}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Value="1"
                                                        Target="Highlight.Opacity" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Value="1"
                                                        Target="Highlight.Opacity" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Highlight"
                                        Opacity="0"
                                        Background="{StaticResource ZoneSplitterHoverBrush}"
                                        IsHitTestVisible="False" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ZonePanelStyle"
                   TargetType="Border">
                <Setter Value="5"
                        Property="Margin" />
                <Setter Value="{StaticResource PanelBrush}"
                        Property="Background" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
<Window x:Class="PersonalEventsBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PersonalEventsBuilder">
    <Grid RequestedTheme="Dark" Background="#202020">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="WorkspaceTitleBar" Title="PersonalEventsBuilder" Background="#141414" Visibility="Collapsed">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xE8A5;" Foreground="#F3AF61" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <MenuBar HorizontalAlignment="Left" Background="Transparent">
                    <MenuBarItem Title="Файл">
                        <MenuFlyoutItem Text="Завантажити базу" Click="OnPendingActionClick" />
                        <MenuFlyoutItem Text="Зберегти подію" Click="OnPendingActionClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Закрити вікно" Click="OnCloseWindowClick" />
                    </MenuBarItem>
                    <MenuBarItem Title="Інструменти">
                        <MenuFlyoutItem Text="Оновити конфіг" Click="OnPendingActionClick" />
                    </MenuBarItem>
                </MenuBar>
            </TitleBar.Content>
        </TitleBar>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Enabled"
                      Background="#202020">
            <Grid MinWidth="1100" Padding="6" ColumnSpacing="5" RowSpacing="5">
                <Grid.Resources>
                    <SolidColorBrush x:Key="PanelBrush" Color="#282828" />
                    <SolidColorBrush x:Key="OutlineBrush" Color="#141414" />
                    <SolidColorBrush x:Key="InsetBrush" Color="#1D1D1D" />
                    <SolidColorBrush x:Key="AmberBrush" Color="#F3AF61" />
                    <Style x:Key="PanelBorder" TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Padding" Value="7" />
                    </Style>
                    <Style x:Key="PanelHeading" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Margin" Value="0,0,0,3" />
                    </Style>
                    <Style x:Key="ModeButton" TargetType="RadioButton">
                        <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="UseSystemFocusVisuals" Value="True" />
                        <Setter Property="MinHeight" Value="26" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                    <Grid x:Name="ModeRoot" MinHeight="{TemplateBinding MinHeight}">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Target="HoverLayer.Opacity" Value="1" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <VisualState.Setters>
                                                        <Setter Target="HoverLayer.Opacity" Value="1" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Disabled">
                                                    <VisualState.Setters>
                                                        <Setter Target="ModeRoot.Opacity" Value="0.45" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                            <VisualStateGroup x:Name="CheckStates">
                                                <VisualState x:Name="Unchecked" />
                                                <VisualState x:Name="Checked">
                                                    <VisualState.Setters>
                                                        <Setter Target="SelectionLayer.Opacity" Value="1" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Indeterminate" />
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Border Background="#383838" BorderBrush="#202020" BorderThickness="1" />
                                        <Border x:Name="HoverLayer" Background="#474747" Opacity="0" />
                                        <Border x:Name="SelectionLayer" Background="#4E3C28" BorderBrush="{StaticResource AmberBrush}"
                                                BorderThickness="1" Opacity="0" />
                                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                                          FontSize="11" Margin="8,2" VerticalAlignment="Center" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="ActionButton" TargetType="Button">
                        <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                        <Setter Property="Background" Value="{StaticResource InsetBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="5,4" />
                        <Setter Property="FontSize" Value="12" />
                    </Style>
                    <Style x:Key="FieldTextBox" TargetType="TextBox">
                        <Setter Property="Background" Value="{StaticResource InsetBrush}" />
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="MinHeight" Value="28" />
                        <Setter Property="Padding" Value="5,3" />
                    </Style>
                    <Style x:Key="ColumnHeading" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Margin" Value="6,4" />
                    </Style>
                </Grid.Resources>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="156" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2.2*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Прибуття" Style="{StaticResource PanelHeading}" />
                            <RadioButton Content="З лікування"
                                         GroupName="EventMode" Checked="OnModeChecked" Style="{StaticResource ModeButton}" />
                            <RadioButton Content="З відрядження"
                                         GroupName="EventMode" Checked="OnModeChecked" Style="{StaticResource ModeButton}" />
                            <RadioButton IsChecked="True" Content="З щорічної відпустки"
                                         GroupName="EventMode" Checked="OnModeChecked" Style="{StaticResource ModeButton}" />
                            <RadioButton Content="З відпустки за сімейними обставинами"
                                         GroupName="EventMode" Checked="OnModeChecked" Style="{StaticResource ModeButton}" />
                            <RadioButton Content="З амбулаторного ВЛК"
                                         GroupName="EventMode" Checked="OnModeChecked" Style="{StaticResource ModeButton}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource PanelBorder}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Вибуття" Style="{StaticResource PanelHeading}" />
                            <RadioButton Content="На лікування"
                                         GroupName="EventMode" Checked="OnModeChecked" Style="{StaticResource ModeButton}" />
                            <RadioButton Content="У відрядження"
                                         GroupName="EventMode" Checked="OnModeChecked" Style="{StaticResource ModeButton}" />
                            <RadioButton Content="У щорічну відпустку"
                                         GroupName="EventMode" Checked="OnModeChecked" Style="{StaticResource ModeButton}" />
                            <RadioButton Content="У відпустку за сімейними обставинами"
                                         GroupName="EventMode" Checked="OnModeChecked" Style="{StaticResource ModeButton}" />
                            <RadioButton Content="На амбулаторне ВЛК"
                                         GroupName="EventMode" Checked="OnModeChecked" Style="{StaticResource ModeButton}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Зміна статусу" Style="{StaticResource PanelHeading}" />
                            <RadioButton Content="Лікування → відпустка"
                                         GroupName="EventMode" Checked="OnModeChecked" Style="{StaticResource ModeButton}" />
                            <RadioButton Content="Відпустка → лікування"
                                         GroupName="EventMode" Checked="OnModeChecked" Style="{StaticResource ModeButton}" />
                            <RadioButton Content="Зміна місця лікування"
                                         GroupName="EventMode" Checked="OnModeChecked" Style="{StaticResource ModeButton}" />
                            <RadioButton Content="Продовження відпустки"
                                         GroupName="EventMode" Checked="OnModeChecked" Style="{StaticResource ModeButton}" />
                            <RadioButton Content="Інша зміна"
                                         GroupName="EventMode" Checked="OnModeChecked" Style="{StaticResource ModeButton}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource PanelBorder}">
                        <Grid RowSpacing="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Прев’ю Word" Style="{StaticResource PanelHeading}" />
                            <Border Grid.Row="1" Background="{StaticResource InsetBrush}"
                                    BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" Padding="10">
                                <TextBlock x:Name="PreviewText" FontSize="13" TextWrapping="Wrap"
                                           Text="З 20 листопада 2026 року:&#10;Коваля Олексія — після щорічної відпустки.&#10;Підстава: рапорт № 42 від 20.11.2026." />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource PanelBorder}">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Дані події" Style="{StaticResource PanelHeading}" />
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="0.7*" />
                                <ColumnDefinition Width="1.08*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.08*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock FontSize="11" Text="ПІБ" />
                                <TextBox AutomationProperties.Name="ПІБ" Style="{StaticResource FieldTextBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock FontSize="11" Text="Рапортуючий" />
                                <TextBox AutomationProperties.Name="Рапортуючий" Style="{StaticResource FieldTextBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="3">
                                <TextBlock FontSize="11" Text="Звання" />
                                <TextBox AutomationProperties.Name="Звання" Style="{StaticResource FieldTextBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="3">
                                <TextBlock FontSize="11" Text="Вх. №" />
                                <TextBox AutomationProperties.Name="Вх. №" Style="{StaticResource FieldTextBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Spacing="3">
                                <TextBlock FontSize="11" Text="Вх. дата" />
                                <CalendarDatePicker AutomationProperties.Name="Вх. дата" HorizontalAlignment="Stretch" MinWidth="0" FontSize="12"
                                                    CornerRadius="0" PlaceholderText="Оберіть дату" />
                            </StackPanel>
                            <StackPanel Grid.Column="5" Spacing="3">
                                <TextBlock FontSize="11" Text="Документ" />
                                <ComboBox AutomationProperties.Name="Документ" HorizontalAlignment="Stretch" MinWidth="0" FontSize="12"
                                                    CornerRadius="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="6" Spacing="3">
                                <TextBlock FontSize="11" Text="№ документа" />
                                <TextBox AutomationProperties.Name="№ документа" Style="{StaticResource FieldTextBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="7" Spacing="3">
                                <TextBlock FontSize="11" Text="Дата події" />
                                <CalendarDatePicker AutomationProperties.Name="Дата події" HorizontalAlignment="Stretch" MinWidth="0" FontSize="12"
                                                    CornerRadius="0" PlaceholderText="Оберіть дату" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Кандидати" Style="{StaticResource PanelHeading}" />
                        <Grid Background="{StaticResource InsetBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ПІБ" Style="{StaticResource ColumnHeading}" />
                            <TextBlock Grid.Column="1" Text="Звання" Style="{StaticResource ColumnHeading}" />
                            <TextBlock Grid.Column="2" Text="Посада" Style="{StaticResource ColumnHeading}" />
                            <TextBlock Grid.Column="3" Text="Документ" Style="{StaticResource ColumnHeading}" />
                            <TextBlock Grid.Column="4" Text="№ документа" Style="{StaticResource ColumnHeading}" />
                            <TextBlock Grid.Column="5" Text="Дата документа" Style="{StaticResource ColumnHeading}" />
                        </Grid>
                        <TextBlock Margin="6,4" FontSize="12" Opacity="0.75" Text="Кандидатів немає" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Grid.RowSpan="3" Style="{StaticResource PanelBorder}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Дії" Style="{StaticResource PanelHeading}" />
                        <Button Content="Завантажити базу" Click="OnPendingActionClick" Style="{StaticResource ActionButton}" />
                        <Button Content="Оновити конфіг" Click="OnPendingActionClick" Style="{StaticResource ActionButton}" />
                        <Button Content="Зберегти подію" Click="OnPendingActionClick" Style="{StaticResource ActionButton}" />
                        <Border Height="1" Background="#484848" Margin="0,3" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AmberBrush}" VerticalAlignment="Top" Margin="0,5,0,0" />
                            <TextBlock x:Name="ActionStatus" Width="120" Text="Готово" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
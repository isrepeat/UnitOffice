<Window x:Class="PersonalEventsBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:PersonalEventsBuilder.Views">
    <Grid RequestedTheme="Dark" Background="#202020">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="WorkspaceTitleBar" Background="#141414" Visibility="Collapsed">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xE8A5;" Foreground="#F3AF61" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <MenuBar HorizontalAlignment="Left" Background="Transparent">
                    <MenuBarItem x:Uid="Tr_FileMenu">
                        <MenuFlyoutItem x:Uid="Tr_LoadDatabaseMenu" Tag="load-database" Click="OnActionClick" />
                        <MenuFlyoutItem x:Uid="Tr_SaveEventMenu" Tag="save-event" Click="OnActionClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="Tr_CloseWindowMenu" Click="OnCloseWindowClick" />
                    </MenuBarItem>
                    <MenuBarItem x:Uid="Tr_ToolsMenu">
                        <MenuFlyoutItem x:Uid="Tr_ReloadConfigurationMenu" Tag="reload-configuration" Click="OnActionClick" />
                    </MenuBarItem>
                    <MenuBarItem x:Uid="Tr_LanguageMenu">
                        <RadioMenuFlyoutItem x:Name="UkrainianLanguageItem" x:Uid="Tr_UkrainianLanguage"
                                             GroupName="UiLanguage" Tag="uk-UA" Click="OnLanguageClick" />
                        <RadioMenuFlyoutItem x:Name="RussianLanguageItem" x:Uid="Tr_RussianLanguage"
                                             GroupName="UiLanguage" Tag="ru-RU" Click="OnLanguageClick" />
                    </MenuBarItem>
                </MenuBar>
            </TitleBar.Content>
        </TitleBar>

        <views:WorkspaceView x:Name="Workspace" Grid.Row="1" />
    </Grid>
</Window>
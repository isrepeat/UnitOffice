<UserControl x:Class="PersonalEventsBuilder.Controls.WindowTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TitleBar x:Name="Caption"
              Background="{StaticResource WorkspaceDeepBrush}"
              BackRequested="OnBackRequested">
        <TitleBar.IconSource>
            <FontIconSource Foreground="{StaticResource WorkspaceAccentBrush}"
                            Glyph="&#xE8A5;" />
        </TitleBar.IconSource>
        <TitleBar.Content>
            <MenuBar HorizontalAlignment="Left"
                     Background="Transparent">
                <MenuBarItem x:Uid="Tr_FileMenu">
                    <MenuFlyoutItem x:Uid="Tr_LoadDatabaseMenu"
                                    x:Name="LoadDatabaseItem" />
                    <MenuFlyoutItem x:Uid="Tr_SaveEventMenu"
                                    x:Name="SaveEventItem" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="Tr_CloseWindowMenu"
                                    Click="OnCloseWindowClick" />
                </MenuBarItem>
                <MenuBarItem x:Uid="Tr_ToolsMenu">
                    <MenuFlyoutItem x:Uid="Tr_ReloadConfigurationMenu"
                                    x:Name="ReloadConfigurationItem" />
                    <MenuFlyoutItem x:Uid="Tr_SettingsMenu"
                                    x:Name="SettingsItem"
                                    Click="OnSettingsClick" />
                </MenuBarItem>
                <MenuBarItem x:Uid="Tr_LanguageMenu">
                    <RadioMenuFlyoutItem x:Uid="Tr_UkrainianLanguage"
                                         x:Name="UkrainianLanguageItem"
                                         Tag="uk-UA"
                                         Click="OnLanguageClick"
                                         GroupName="UiLanguage" />
                    <RadioMenuFlyoutItem x:Uid="Tr_RussianLanguage"
                                         x:Name="RussianLanguageItem"
                                         Tag="ru-RU"
                                         Click="OnLanguageClick"
                                         GroupName="UiLanguage" />
                </MenuBarItem>
            </MenuBar>
        </TitleBar.Content>
    </TitleBar>
</UserControl>
<Button x:Class="PersonalEventsBuilder.Controls.PlaceholderButton"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:controls="using:PersonalEventsBuilder.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        UseSystemFocusVisuals="False"
        MinWidth="0"
        Height="36"
        Padding="2,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalContentAlignment="Center"
        VerticalContentAlignment="Center"
        Background="{StaticResource CommandBrush}"
        BorderBrush="{StaticResource ZoneSplitterBrush}"
        Foreground="{StaticResource CommandTextBrush}"
        CornerRadius="0">
    <Button.Template>
        <ControlTemplate TargetType="controls:PlaceholderButton">
            <Grid>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Target="HoverLayer.Opacity"
                                        Value="0" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Target="HoverLayer.Opacity"
                                        Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Target="HoverLayer.Opacity"
                                        Value="0" />
                                <Setter Target="Presenter.Background"
                                        Value="{StaticResource LowerFieldBrush}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Target="HoverLayer.Opacity"
                                        Value="0" />
                                <Setter Target="Presenter.Background"
                                        Value="{ThemeResource ButtonBackgroundDisabled}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border x:Name="Presenter"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <Grid Margin="12,0">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Opacity="0"
                                          IsHitTestVisible="False" />
                        <controls:PlaceholderLines LineWidths="{TemplateBinding PlaceholderLines_LineWidths}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   Opacity="0.65" />
                    </Grid>
                </Border>
                <Border x:Name="HoverLayer"
                        OpacityTransition="{StaticResource HoverTransition}"
                        Style="{StaticResource HoverLayerStyle}" />
                <Border x:Name="FocusFrame"
                        Style="{StaticResource ActiveEntityFrameStyle}"
                        Visibility="Collapsed" />
            </Grid>
        </ControlTemplate>
    </Button.Template>
</Button>
<Button x:Class="PersonalEventsBuilder.Controls.PlaceholderButton"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PersonalEventsBuilder.Controls"
        MinWidth="0"
        Height="36"
        Padding="2,0"
        VerticalAlignment="Stretch"
        HorizontalAlignment="Stretch"
        VerticalContentAlignment="Center"
        HorizontalContentAlignment="Center"
        Background="{StaticResource CommandBrush}"
        Foreground="{StaticResource CommandTextBrush}"
        BorderBrush="{StaticResource ZoneSplitterBrush}"
        CornerRadius="0"
        UseSystemFocusVisuals="False">
    <Button.Template>
        <ControlTemplate TargetType="controls:PlaceholderButton">
            <Grid>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Value="0"
                                        Target="HoverLayer.Opacity" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Value="1"
                                        Target="HoverLayer.Opacity" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Value="0"
                                        Target="HoverLayer.Opacity" />
                                <Setter Value="{StaticResource LowerFieldBrush}"
                                        Target="Presenter.Background" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Value="0"
                                        Target="HoverLayer.Opacity" />
                                <Setter Value="{ThemeResource ButtonBackgroundDisabled}"
                                        Target="Presenter.Background" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border x:Name="Presenter"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <Grid Margin="12,0">
                        <ContentPresenter Visibility="{Binding DataVisibility, Source={StaticResource WorkspaceContentMode}}"
                                          Content="{TemplateBinding Content}"
                                          IsHitTestVisible="False" />
                        <controls:PlaceholderLines Opacity="0.65"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   LineWidths="{TemplateBinding PlaceholderLines_LineWidths}" />
                    </Grid>
                </Border>
                <Border x:Name="HoverLayer"
                        Style="{StaticResource HoverLayerStyle}"
                        OpacityTransition="{StaticResource HoverTransition}" />
                <Border x:Name="FocusFrame"
                        Style="{StaticResource ActiveEntityFrameStyle}"
                        Visibility="Collapsed" />
            </Grid>
        </ControlTemplate>
    </Button.Template>
</Button>
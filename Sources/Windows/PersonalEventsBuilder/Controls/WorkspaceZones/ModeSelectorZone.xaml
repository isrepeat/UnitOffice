<UserControl x:Class="PersonalEventsBuilder.Controls.WorkspaceZones.ModeSelectorZone"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:PersonalEventsBuilder.Controls">
    <ItemsControl ItemsSource="{Binding ModeGroups}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <controls:EqualWidthColumnsPanel />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Style="{StaticResource PanelBorder}">
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource PanelHeading}"
                                   Text="{Binding Title}" />
                        <ItemsControl ItemsSource="{Binding Modes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource ModeButton}"
                                                 Content="{Binding Title}"
                                                 Tag="{Binding}"
                                                 IsChecked="{Binding IsDefault, Mode=OneTime}"
                                                 GroupName="EventMode"
                                                 Checked="OnModeChecked" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
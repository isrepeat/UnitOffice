<UserControl x:Class="PersonalEventsBuilder.Controls.WorkspaceZones.WorkspaceActionsZone"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PanelBorder}">
        <StackPanel Spacing="6">
            <TextBlock x:Uid="Tr_ActionsHeading"
                       Style="{StaticResource PanelHeading}" />
            <ItemsControl ItemsSource="{Binding Actions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ActionButton}"
                                Content="{Binding Title}"
                                Tag="{Binding Id}"
                                IsEnabled="{Binding IsEnabled}"
                                Click="OnActionClick" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Height="1"
                    Margin="0,3"
                    Background="#484848" />
            <StackPanel Orientation="Horizontal"
                        Spacing="6">
                <Ellipse Width="7"
                         Height="7"
                         Margin="0,5,0,0"
                         Fill="{StaticResource AmberBrush}"
                         VerticalAlignment="Top" />
                <TextBlock Width="120"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Text="{Binding Status}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
<UserControl x:Class="PersonalEventsBuilder.Controls.WorkspaceZones.CandidatesZone"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:PersonalEventsBuilder.Controls">
    <Border Style="{StaticResource PanelBorder}">
        <StackPanel Spacing="3">
            <TextBlock x:Uid="Tr_CandidatesHeading"
                       Style="{StaticResource PanelHeading}" />
            <controls:CandidateRowView Background="{StaticResource InsetBrush}"
                                       DataContext="{Binding CandidateHeadings}" />
            <ListView MaxHeight="260"
                      ItemsSource="{Binding CandidateRows}"
                      SelectionChanged="OnCandidateSelected">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch" />
                        <Setter Property="Padding"
                                Value="0" />
                        <Setter Property="MinHeight"
                                Value="24" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <controls:CandidateRowView DataContext="{Binding Cells}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Margin="6,4"
                       Opacity="0.75"
                       FontSize="12"
                       Text="{Binding CandidateStatus}" />
        </StackPanel>
    </Border>
</UserControl>
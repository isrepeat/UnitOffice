<UserControl x:Class="PersonalEventsBuilder.Controls.WorkspaceZones.EventFormZone"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:PersonalEventsBuilder.Controls">
    <Border x:Name="FormBorder"
            Style="{StaticResource PanelBorder}">
        <StackPanel Spacing="3">
            <TextBlock x:Name="FormHeading"
                       x:Uid="Tr_EventDetailsHeading"
                       Style="{StaticResource PanelHeading}" />
            <controls:NavigationMatrix x:Name="FormMatrix">
                <Grid x:Name="FieldColumns"
                      ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftColumn"
                                          Width="Auto"
                                          MinWidth="106" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto"
                                          MinWidth="106" />
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="#9B703D"
                            BorderThickness="1"
                            IsHitTestVisible="False" />
                    <controls:Form Margin="4"
                                   FlowDirection="RightToLeft"
                                   ItemsSource="{Binding LeftForm}" />
                    <controls:Form Grid.Column="1"
                                   Margin="0,4"
                                   ItemsSource="{Binding CenterForm}" />
                    <Border Grid.Column="2"
                            BorderBrush="#9B703D"
                            BorderThickness="1"
                            IsHitTestVisible="False" />
                    <controls:Form Grid.Column="2"
                                   Margin="4"
                                   ItemsSource="{Binding RightForm}" />
                </Grid>
            </controls:NavigationMatrix>
        </StackPanel>
    </Border>
</UserControl>
<UserControl x:Class="PersonalEventsBuilder.Controls.WorkspaceZones.MainZone"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:main="using:PersonalEventsBuilder.Controls.WorkspaceZones.MainZoneSections"
             IsTabStop="True"
             GotFocus="OnWorkspaceGotFocus"
             PreviewKeyDown="OnWorkspaceKeyDown">
    <Border Style="{StaticResource PanelBorder}">
        <ScrollViewer x:Name="WorkspaceViewport"
                      IsTabStop="False"
                      HorizontalScrollMode="Enabled"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Auto"
                      SizeChanged="OnViewportSizeChanged"
                      ViewChanged="OnViewportChanged">
            <Grid x:Name="WorkspaceSurface"
                  Background="Transparent"
                  SizeChanged="OnWorkspaceSurfaceSizeChanged"
                  Tapped="OnWorkspaceTapped"
                  DoubleTapped="OnWorkspaceDoubleTapped">
                <Canvas IsHitTestVisible="False">
                    <Path Canvas.Left="{x:Bind GridDrawing.Left, Mode=OneWay}"
                          Canvas.Top="{x:Bind GridDrawing.Top, Mode=OneWay}"
                          Data="{x:Bind GridDrawing.Geometry, Mode=OneWay}"
                          Stroke="{StaticResource OutlineBrush}"
                          StrokeThickness="1" />
                </Canvas>
                <StackPanel>
                    <main:EventFormSection Height="{x:Bind Layout.Form.Height, Mode=OneWay}"
                                        ViewModel="{x:Bind Layout.Form, Mode=OneWay}"
                                        Visibility="{x:Bind Layout.Form.IsVisible, Mode=OneWay, FallbackValue=Collapsed}" />
                    <main:SummarySection ViewModel="{x:Bind Layout.Summary, Mode=OneWay}"
                                      IsHitTestVisible="False"
                                      Visibility="{x:Bind Layout.Summary.IsVisible, Mode=OneWay, FallbackValue=Collapsed}" />
                    <main:CandidatesSection Height="{x:Bind Layout.Candidates.Height, Mode=OneWay}"
                                         ViewModel="{x:Bind Layout.Candidates, Mode=OneWay}"
                                         IsHitTestVisible="False"
                                         Visibility="{x:Bind Layout.Candidates.IsVisible, Mode=OneWay, FallbackValue=Collapsed}" />
                </StackPanel>
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="FocusOutline"
                            BorderBrush="{StaticResource AmberBrush}"
                            BorderThickness="1"
                            Visibility="Collapsed" />
                </Canvas>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
<UserControl x:Class="PersonalEventsBuilder.Controls.WorkspaceZones.MainZone"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:main="using:PersonalEventsBuilder.Controls.WorkspaceZones.MainZoneSections"
             IsTabStop="True"
             AllowFocusOnInteraction="False"
             GotFocus="OnWorkspaceGotFocus"
             PreviewKeyDown="OnWorkspaceKeyDown">
    <UserControl.Resources>
        <Style x:Key="ExtensionGroupBorderStyle"
               TargetType="Border">
            <Setter Property="BorderBrush"
                    Value="{StaticResource AmberBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
        </Style>
        <main:FormDefinition x:Key="EventFormDefinition">
            <main:FormDefinition.Groups>
                <main:FormGroup Placement="Primary"
                                    Row="0"
                                    Column="2">
                    <main:FormGroup.Fields>
                        <main:FormField Id="person"
                                            ColumnSpan="3"
                                            LabelKey="Tr_WorkspacePerson"
                                            LabelPlacement="Above" />
                        <main:FormField Id="rank"
                                            ColumnSpan="2"
                                            LabelKey="Tr_WorkspaceRank"
                                            LabelPlacement="Above" />
                        <main:FormField Id="document-number"
                                            ColumnSpan="4"
                                            LabelKey="Tr_WorkspaceDocumentNumber"
                                            LabelPlacement="Above" />
                    </main:FormGroup.Fields>
                </main:FormGroup>
                <main:FormGroup Placement="Left"
                                    BorderStyle="{StaticResource ExtensionGroupBorderStyle}">
                    <main:FormGroup.Fields>
                        <main:FormField Id="destination"
                                            ColumnSpan="2"
                                            LabelKey="Tr_WorkspaceDestination"
                                            LabelPlacement="Above" />
                    </main:FormGroup.Fields>
                </main:FormGroup>
                <main:FormGroup Placement="Right"
                                    BorderStyle="{StaticResource ExtensionGroupBorderStyle}">
                    <main:FormGroup.Fields>
                        <main:FormField Id="departure-date"
                                            ColumnSpan="2"
                                            LabelKey="Tr_WorkspaceDepartureDate"
                                            LabelPlacement="Above" />
                    </main:FormGroup.Fields>
                </main:FormGroup>
                <main:FormGroup Placement="BelowField"
                                    AnchorFieldId="document-number"
                                    Orientation="Vertical"
                                    BorderStyle="{StaticResource ExtensionGroupBorderStyle}">
                    <main:FormGroup.Fields>
                        <main:FormField Id="notes"
                                            ColumnSpan="4"
                                            LabelKey="Tr_WorkspaceNotes"
                                            LabelPlacement="Above" />
                    </main:FormGroup.Fields>
                </main:FormGroup>
            </main:FormDefinition.Groups>
        </main:FormDefinition>
    </UserControl.Resources>
    <Border Style="{StaticResource PanelBorder}">
        <ScrollViewer x:Name="WorkspaceViewport"
                      IsTabStop="False"
                      AllowFocusOnInteraction="False"
                      HorizontalScrollMode="Enabled"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Auto"
                      SizeChanged="OnViewportSizeChanged"
                      ViewChanged="OnViewportChanged">
            <Grid x:Name="WorkspaceSurface"
                  Background="Transparent"
                  SizeChanged="OnWorkspaceSurfaceSizeChanged"
                  PointerPressed="OnWorkspacePointerPressed"
                  Tapped="OnWorkspaceTapped"
                  DoubleTapped="OnWorkspaceDoubleTapped">
                <Canvas IsHitTestVisible="False">
                    <Path Canvas.Left="{x:Bind GridDrawing.Left, Mode=OneWay}"
                          Canvas.Top="{x:Bind GridDrawing.Top, Mode=OneWay}"
                          Data="{x:Bind GridDrawing.Geometry, Mode=OneWay}"
                          Stroke="{StaticResource OutlineBrush}"
                          StrokeThickness="1" />
                </Canvas>
                <StackPanel>
                    <main:EventFormSection Height="{x:Bind Layout.Form.Height, Mode=OneWay}"
                                        ViewModel="{x:Bind Layout.Form, Mode=OneWay}"
                                        Visibility="{x:Bind Layout.Form.IsVisible, Mode=OneWay, FallbackValue=Collapsed}" />
                    <main:SummarySection ViewModel="{x:Bind Layout.Summary, Mode=OneWay}"
                                      IsHitTestVisible="False"
                                      Visibility="{x:Bind Layout.Summary.IsVisible, Mode=OneWay, FallbackValue=Collapsed}" />
                    <main:CandidatesSection Height="{x:Bind Layout.Candidates.Height, Mode=OneWay}"
                                         ViewModel="{x:Bind Layout.Candidates, Mode=OneWay}"
                                         IsHitTestVisible="False"
                                         Visibility="{x:Bind Layout.Candidates.IsVisible, Mode=OneWay, FallbackValue=Collapsed}" />
                </StackPanel>
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="FocusOutline"
                            BorderBrush="{StaticResource AmberBrush}"
                            BorderThickness="1"
                            Visibility="Collapsed" />
                </Canvas>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
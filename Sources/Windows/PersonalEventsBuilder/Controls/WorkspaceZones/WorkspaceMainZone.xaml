<UserControl x:Class="PersonalEventsBuilder.Controls.WorkspaceZones.WorkspaceMainZone"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PanelBorder}">
        <Grid RowSpacing="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Uid="Tr_EventDetailsHeading"
                       Style="{StaticResource PanelHeading}" />
            <Grid Grid.Row="1" />
        </Grid>
    </Border>
</UserControl>
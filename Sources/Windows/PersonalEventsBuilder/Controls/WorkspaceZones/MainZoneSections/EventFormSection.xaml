<UserControl x:Class="PersonalEventsBuilder.Controls.WorkspaceZones.MainZoneSections.EventFormSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Canvas>
        <Canvas x:Name="FieldLabels"
                IsHitTestVisible="False" />
        <Canvas x:Name="FieldValues"
                IsHitTestVisible="False" />
        <TextBox x:Name="FieldEditor"
                 MinWidth="0"
                 MinHeight="0"
                 Padding="6,2"
                 Visibility="Collapsed"
                 TextChanged="OnFieldEditorTextChanged"
                 LostFocus="OnFieldEditorLostFocus" />
    </Canvas>
</UserControl>
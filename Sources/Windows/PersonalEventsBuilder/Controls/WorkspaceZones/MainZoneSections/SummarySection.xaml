<UserControl x:Class="PersonalEventsBuilder.Controls.WorkspaceZones.MainZoneSections.SummarySection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="Tr_WorkspaceSummaryHeading"
                   Style="{StaticResource WorkspaceCellText}" />
        <TextBlock Grid.Row="1"
                   Style="{StaticResource WorkspaceCellText}"
                   TextWrapping="Wrap"
                   Text="{x:Bind ViewModel.Text, Mode=OneWay}" />
    </Grid>
</UserControl>
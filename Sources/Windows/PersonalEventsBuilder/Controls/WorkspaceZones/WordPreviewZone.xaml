<UserControl x:Class="PersonalEventsBuilder.Controls.WorkspaceZones.WordPreviewZone"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PanelBorder}">
        <Grid RowSpacing="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Uid="Tr_WordPreviewHeading"
                       Style="{StaticResource PanelHeading}" />
            <Border Grid.Row="1"
                    Padding="10"
                    Background="{StaticResource InsetBrush}"
                    BorderBrush="{StaticResource OutlineBrush}"
                    BorderThickness="1">
                <TextBlock FontSize="13"
                           TextWrapping="Wrap"
                           Text="{Binding Preview}" />
            </Border>
        </Grid>
    </Border>
</UserControl>
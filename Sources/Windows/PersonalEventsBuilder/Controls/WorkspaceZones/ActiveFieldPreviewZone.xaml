<UserControl x:Class="PersonalEventsBuilder.Controls.WorkspaceZones.ActiveFieldPreviewZone"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Background="#262626"
                  HorizontalScrollMode="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="ActiveFieldPreviewText"
                   Margin="10,3"
                   FontSize="12"
                   TextWrapping="Wrap"
                   IsTextSelectionEnabled="True" />
    </ScrollViewer>
</UserControl>
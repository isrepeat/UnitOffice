<UserControl x:Class="PersonalEventsBuilder.Controls.WorkspaceZones.MainZones.MatrixZone"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsTabStop="True"
             PreviewKeyDown="OnMatrixKeyDown">
    <UserControl.Resources>
        <Style x:Key="MatrixFieldText"
               TargetType="TextBlock">
            <Setter Property="Padding"
                    Value="5,4" />
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis" />
            <Setter Property="FontSize"
                    Value="12" />
        </Style>
    </UserControl.Resources>
    <Grid RowSpacing="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="Tr_EventDetailsHeading"
                   Style="{StaticResource PanelHeading}" />
        <ScrollViewer x:Name="MatrixViewport"
                      Grid.Row="1"
                      Height="180"
                      HorizontalScrollMode="Enabled"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Auto"
                      SizeChanged="OnViewportSizeChanged"
                      ViewChanged="OnViewportChanged">
            <Canvas x:Name="MatrixSurface"
                    Background="Transparent"
                    Tapped="OnMatrixTapped"
                    DoubleTapped="OnMatrixDoubleTapped">
                <Path x:Name="GridLines"
                      Stroke="{StaticResource OutlineBrush}"
                      StrokeThickness="1"
                      IsHitTestVisible="False" />
                <Canvas x:Name="FieldLabels"
                        IsHitTestVisible="False" />
                <Border x:Name="SelectionOutline"
                        BorderBrush="{StaticResource AmberBrush}"
                        BorderThickness="1"
                        IsHitTestVisible="False"
                        Visibility="Collapsed" />
                <TextBox x:Name="CellEditor"
                         MinWidth="0"
                         MinHeight="0"
                         Padding="5,2"
                         Visibility="Collapsed"
                         LostFocus="OnEditorLostFocus" />
            </Canvas>
        </ScrollViewer>
    </Grid>
</UserControl>
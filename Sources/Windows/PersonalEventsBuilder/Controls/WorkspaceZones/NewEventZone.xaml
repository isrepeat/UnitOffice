<UserControl x:Class="PersonalEventsBuilder.Controls.WorkspaceZones.NewEventZone"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="2"
            Style="{StaticResource PanelBorder}">
        <Button MinHeight="60"
                Padding="3"
                Background="#303030"
                BorderBrush="#414141"
                BorderThickness="1"
                CornerRadius="0"
                Foreground="#D0D0D0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                AutomationProperties.LabeledBy="{Binding ElementName=NewEventLabel}"
                IsEnabled="{Binding CanStartNewEvent}"
                Click="OnNewEventClick">
            <Button.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                 Color="#484848" />
                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                 Color="#696969" />
                <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                 Color="#3B3B3B" />
                <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                 Color="#5A5A5A" />
            </Button.Resources>
            <StackPanel Spacing="4">
                <FontIcon HorizontalAlignment="Center"
                          FontSize="12"
                          Glyph="&#xE72C;" />
                <TextBlock x:Uid="Tr_NewEventLabel"
                           x:Name="NewEventLabel"
                           FontSize="11"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Button>
    </Border>
</UserControl>
<UserControl x:Class="PersonalEventsBuilder.Controls.CandidateRowView"
             x:Name="RowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:PersonalEventsBuilder.Controls">
    <ItemsControl Background="{Binding Background, ElementName=RowView}"
                  HorizontalContentAlignment="Stretch"
                  ItemsSource="{Binding}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <controls:EqualWidthColumnsPanel />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <TextBlock Margin="6,4"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding}" />
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
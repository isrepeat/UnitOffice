<UserControl x:Class="PersonalEventsBuilder.Controls.GridCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsTabStop="True">
    <Canvas x:Name="Surface"
            Background="Transparent">
        <Path x:Name="Lines"
              Stroke="{StaticResource ZoneSplitterBrush}"
              StrokeThickness="1"
              IsHitTestVisible="False" />
        <Canvas x:Name="Targets"
                IsHitTestVisible="False" />
        <Canvas x:Name="Labels"
                IsHitTestVisible="False" />
    </Canvas>
</UserControl>
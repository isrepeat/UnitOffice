<UserControl x:Class="PersonalEventsBuilder.Controls.GridCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsTabStop="True">
    <Grid x:Name="Surface"
          Background="Transparent">
        <Canvas IsHitTestVisible="False">
            <Canvas.Clip>
                <RectangleGeometry x:Name="ViewportClip" />
            </Canvas.Clip>
            <Path x:Name="Lines"
                  Stroke="{StaticResource ZoneSplitterBrush}"
                  StrokeThickness="1" />
            <Canvas x:Name="Targets" />
            <Canvas x:Name="Labels" />
        </Canvas>
    </Grid>
</UserControl>
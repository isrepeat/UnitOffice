<UserControl x:Class="PersonalEventsBuilder.Controls.PlaceholderLines"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             VerticalAlignment="Center"
             Opacity="0.32"
             Foreground="{StaticResource WorkspaceTextBrush}"
             IsTabStop="False"
             IsHitTestVisible="False">
    <UserControl.Resources>
        <DataTemplate x:Key="LineTemplate">
            <Grid ColumnDefinitions="*,*">
                <Rectangle Height="3"
                           Fill="{Binding}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel x:Name="Lines"
                Visibility="{Binding PlaceholderVisibility, Source={StaticResource WorkspaceContentMode}}"
                Spacing="6" />
</UserControl>
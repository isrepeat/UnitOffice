<Page x:Class="PersonalEventsBuilder.Pages.WorkspacePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:views="using:PersonalEventsBuilder.Views"
      xmlns:udkGrid="using:UDK.WinUI.Grid"
      xmlns:udkLayout="using:UDK.WinUI.Layout"
      xmlns:udkLayoutControls="using:UDK.WinUI.Layout.Controls"
      Style="{StaticResource WorkspacePageStyle}">
    <SplitView x:Name="PaletteDrawer"
               PaneClosed="OnPaletteClosed"
               DisplayMode="Overlay"
               PanePlacement="Right"
               OpenPaneLength="336">
        <SplitView.Pane>
            <views:PaletteEditor x:Name="Palette"
                                 CloseRequested="OnClosePalette" />
        </SplitView.Pane>
        <udkLayoutControls:WorkspaceHost x:Name="Workspace">
            <udkLayoutControls:WorkspaceHost.Resources>
                <udkGrid:GridNavigation x:Key="EventNavigation" />
                <udkGrid:GridAxis x:Key="EventColumns"
                                  Step="116"
                                  Count="{x:Bind WorkspacePageViewModel.EventLayout.ColumnCount, Mode=OneWay}" />
                <udkGrid:GridLayout x:Key="FormGrid"
                                    Columns="{StaticResource EventColumns}"
                                    Navigation="{StaticResource EventNavigation}">
                    <udkGrid:GridLayout.Rows>
                        <udkGrid:GridAxis Step="40" />
                    </udkGrid:GridLayout.Rows>
                </udkGrid:GridLayout>
                <udkGrid:GridLayout x:Key="CandidatesGrid"
                                    Columns="{StaticResource EventColumns}"
                                    Navigation="{StaticResource EventNavigation}"
                                    NavigationOrder="1">
                    <udkGrid:GridLayout.Rows>
                        <udkGrid:GridAxis Step="28"
                                          Count="15" />
                    </udkGrid:GridLayout.Rows>
                </udkGrid:GridLayout>
                <udkGrid:GridLayout x:Key="TestCandidatesGrid"
                                    Columns="{StaticResource EventColumns}"
                                    Navigation="{StaticResource EventNavigation}"
                                    NavigationOrder="2">
                    <udkGrid:GridLayout.Rows>
                        <udkGrid:GridAxis Step="28"
                                          Count="15" />
                    </udkGrid:GridLayout.Rows>
                </udkGrid:GridLayout>
                <Style BasedOn="{StaticResource ZoneSplitterStyle}"
                       TargetType="Thumb" />
                <Style BasedOn="{StaticResource ZoneLabelStyle}"
                       TargetType="TextBlock" />
            </udkLayoutControls:WorkspaceHost.Resources>
            <udkLayout:Zone Direction="Columns">
                <udkLayout:Zone Direction="Rows">
                    <udkLayout:Zone Size="194"
                                    MinSize="48"
                                    Direction="Columns">
                        <udkLayout:Zone Style="{StaticResource ZonePanelStyle}"
                                        Size="1.44*">
                            <views:CommandPanel x:Name="Commands" />
                        </udkLayout:Zone>
                        <udkLayout:Splitter />
                        <udkLayout:Zone Style="{StaticResource ZonePanelStyle}"
                                        Size="149">
                            <TextBlock Text="Новое событие" />
                        </udkLayout:Zone>
                        <udkLayout:Splitter />
                        <udkLayout:Zone Style="{StaticResource ZonePanelStyle}"
                                        Size="*">
                            <views:WordPreview />
                        </udkLayout:Zone>
                    </udkLayout:Zone>
                    <udkLayout:Splitter />
                    <udkLayout:Zone Direction="Rows"
                                    MinSize="96"
                                    SequentialScroll="True">
                        <udkLayout:Zone.HorizontalScrollBehavior>
                            <udkGrid:GridAxisScroll Axis="{StaticResource EventColumns}" />
                        </udkLayout:Zone.HorizontalScrollBehavior>
                        <udkLayout:Zone Style="{StaticResource ZonePanelStyle}"
                                        Title="Форма события"
                                        Size="Auto">
                            <views:EventForm GridLayout="{StaticResource FormGrid}"
                                             Fields="{x:Bind WorkspacePageViewModel.EventLayout.Fields, Mode=OneWay}" />
                        </udkLayout:Zone>
                        <!--<udkLayout:Splitter />-->
                        <udkLayout:Zone Direction="Columns"
                                        Title="Кандидати"
                                        Size="Auto">
                            <udkLayout:Zone Style="{StaticResource ZonePanelStyle}"
                                            Size="96" />
                            <udkLayout:Splitter />
                            <udkLayout:Zone Style="{StaticResource ZonePanelStyle}"
                                            MinSize="116">
                                <views:CandidatesTable GridLayout="{StaticResource CandidatesGrid}"
                                                       Columns="{x:Bind WorkspacePageViewModel.EventLayout.MainColumns, Mode=OneWay}" />
                            </udkLayout:Zone>
                            <udkLayout:Splitter />
                            <udkLayout:Zone Style="{StaticResource ZonePanelStyle}"
                                            Size="96" />
                        </udkLayout:Zone>
                        <udkLayout:Zone Style="{StaticResource ZonePanelStyle}"
                                        Title="Тестовая таблица"
                                        Size="Auto">
                            <views:CandidatesTable GridLayout="{StaticResource TestCandidatesGrid}"
                                                   Columns="{x:Bind WorkspacePageViewModel.EventLayout.MainColumns, Mode=OneWay}" />
                        </udkLayout:Zone>
                    </udkLayout:Zone>
                </udkLayout:Zone>
                <udkLayout:Splitter />
                <udkLayout:Zone Style="{StaticResource ZonePanelStyle}"
                                Size="218"
                                MinSize="100">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <Button x:Uid="Tr_PaletteOpen"
                                x:Name="PaletteButton"
                                Margin="6"
                                HorizontalAlignment="Right"
                                Click="OnOpenPalette" />
                        <ToggleButton Grid.Row="1"
                                      x:Uid="Tr_ShowPlaceholders"
                                      Margin="6,0,6,6"
                                      HorizontalAlignment="Right"
                                      IsChecked="{Binding ShowPlaceholders, Mode=TwoWay, Source={StaticResource WorkspaceContentMode}}" />
                        <TextBlock Grid.Row="2"
                                   Text="Действия" />
                    </Grid>
                </udkLayout:Zone>
            </udkLayout:Zone>
        </udkLayoutControls:WorkspaceHost>
    </SplitView>
</Page>
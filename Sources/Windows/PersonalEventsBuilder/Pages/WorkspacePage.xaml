<Page x:Class="PersonalEventsBuilder.Pages.WorkspacePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:PersonalEventsBuilder.Controls"
      xmlns:layout="using:UDK.WinUI.Layout"
      xmlns:views="using:PersonalEventsBuilder.Views"
      xmlns:grid="using:UDK.WinUI.Grid"
      Style="{StaticResource WorkspacePageStyle}"
      NavigationCacheMode="Required">
    <layout:WorkspaceHost>
        <layout:WorkspaceHost.Resources>
            <ControlTemplate x:Key="ButtonColumnTemplate"
                             TargetType="ContentControl">
                <StackPanel Spacing="3">
                    <controls:PlaceholderButton x:Uid="Tr_PlaceholderButton1" />
                    <controls:PlaceholderButton x:Uid="Tr_PlaceholderButton2" />
                    <controls:PlaceholderButton x:Uid="Tr_PlaceholderButton3" />
                    <controls:PlaceholderButton x:Uid="Tr_PlaceholderButton4" />
                </StackPanel>
            </ControlTemplate>
            <grid:GridNavigation x:Key="EventNavigation" />
            <grid:GridAxis x:Key="EventColumns"
                           Step="116"
                           Count="24" />
            <grid:GridLayout x:Key="FormGrid"
                             Columns="{StaticResource EventColumns}"
                             Navigation="{StaticResource EventNavigation}">
                <grid:GridLayout.Rows>
                    <grid:GridAxis Step="40"
                                   Count="6" />
                </grid:GridLayout.Rows>
            </grid:GridLayout>
            <grid:GridLayout x:Key="CandidatesGrid"
                             NavigationOrder="1"
                             Columns="{StaticResource EventColumns}"
                             Navigation="{StaticResource EventNavigation}">
                <grid:GridLayout.Rows>
                    <grid:GridAxis Step="28"
                                   Count="30" />
                </grid:GridLayout.Rows>
            </grid:GridLayout>
            <Style TargetType="Thumb"
                   BasedOn="{StaticResource ZoneSplitterStyle}" />
            <Style TargetType="TextBlock"
                   BasedOn="{StaticResource ZoneLabelStyle}" />
        </layout:WorkspaceHost.Resources>
        <layout:Zone Direction="Columns">
            <layout:Zone Direction="Rows">
                <layout:Zone Size="194"
                             MinSize="48"
                             Direction="Columns">
                    <layout:Zone Size="1.44*"
                                 Style="{StaticResource ZonePanelStyle}">
                        <Grid Margin="4"
                              RowDefinitions="Auto,*"
                              RowSpacing="3">
                            <Grid ColumnDefinitions="*,*,*"
                                  ColumnSpacing="6">
                                <TextBlock Text="Прибытие" />
                                <TextBlock Grid.Column="1"
                                           Text="Убытие" />
                                <TextBlock Grid.Column="2"
                                           Text="Изменение статуса" />
                            </Grid>
                            <ScrollViewer Grid.Row="1"
                                          HorizontalContentAlignment="Stretch"
                                          HorizontalScrollMode="Disabled"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollMode="Enabled"
                                          VerticalScrollBarVisibility="Hidden">
                                <Grid ColumnDefinitions="*,*,*"
                                      ColumnSpacing="6">
                                    <ContentControl IsTabStop="False"
                                                    Template="{StaticResource ButtonColumnTemplate}" />
                                    <ContentControl Grid.Column="1"
                                                    IsTabStop="False"
                                                    Template="{StaticResource ButtonColumnTemplate}" />
                                    <Grid Grid.Column="2"
                                          RowDefinitions="75,75"
                                          ColumnDefinitions="*,*"
                                          RowSpacing="3"
                                          ColumnSpacing="3">
                                        <controls:PlaceholderButton Height="Auto">
                                            <TextBlock x:Uid="Tr_ExtendMedicalLeave"
                                                       FontSize="12"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </controls:PlaceholderButton>
                                        <controls:PlaceholderButton Grid.Column="1"
                                                                    Height="Auto">
                                            <TextBlock x:Uid="Tr_TreatmentToMedicalLeave"
                                                       FontSize="12"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </controls:PlaceholderButton>
                                        <controls:PlaceholderButton Grid.Row="1"
                                                                    Height="Auto">
                                            <TextBlock x:Uid="Tr_MedicalLeaveToHospital"
                                                       FontSize="12"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </controls:PlaceholderButton>
                                        <controls:PlaceholderButton Grid.Row="1"
                                                                    Grid.Column="1"
                                                                    Height="Auto">
                                            <TextBlock x:Uid="Tr_AbsenceToAssignment"
                                                       FontSize="12"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </controls:PlaceholderButton>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </layout:Zone>
                    <layout:Splitter />
                    <layout:Zone Size="149"
                                 Style="{StaticResource ZonePanelStyle}">
                        <TextBlock Text="Новое событие" />
                    </layout:Zone>
                    <layout:Splitter />
                    <layout:Zone Size="*"
                                 Style="{StaticResource ZonePanelStyle}">
                        <TextBlock Text="Превью Word" />
                    </layout:Zone>
                </layout:Zone>
                <layout:Splitter />
                <layout:Zone MinSize="96"
                             Direction="Rows">
                    <layout:Zone Size="2*"
                                 Style="{StaticResource ZonePanelStyle}">
                        <views:EventForm GridLayout="{StaticResource FormGrid}" />
                    </layout:Zone>
                    <layout:Zone Size="*"
                                 Style="{StaticResource ZonePanelStyle}">
                        <TextBlock Text="Сводка" />
                    </layout:Zone>
                    <layout:Zone Size="3*"
                                 Direction="Columns">
                        <layout:Zone Size="160"
                                     MinSize="8"
                                     Style="{StaticResource ZonePanelStyle}" />
                        <layout:Splitter />
                        <layout:Zone MinSize="120"
                                     Style="{StaticResource ZonePanelStyle}">
                            <views:CandidatesTable GridLayout="{StaticResource CandidatesGrid}" />
                        </layout:Zone>
                        <layout:Splitter />
                        <layout:Zone Size="160"
                                     MinSize="40"
                                     Style="{StaticResource ZonePanelStyle}" />
                    </layout:Zone>
                </layout:Zone>
            </layout:Zone>
            <layout:Splitter />
            <layout:Zone Size="218"
                         MinSize="100"
                         Style="{StaticResource ZonePanelStyle}">
                <TextBlock Text="Действия" />
            </layout:Zone>
        </layout:Zone>
    </layout:WorkspaceHost>
</Page>
<Page x:Class="PersonalEventsBuilder.Pages.WorkspacePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:zones="using:PersonalEventsBuilder.Controls.WorkspaceZones"
      DataContext="{x:Bind ViewModel}"
      NavigationCacheMode="Required">
    <Grid Background="#202020">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <zones:ActiveFieldPreviewZone x:Name="ActiveFieldPreview"
                                      Height="24"
                                      Margin="6,5,6,0" />

        <Thumb x:Name="PreviewResizeHandle"
               Grid.Row="1"
               Height="8"
               Margin="6,0"
               Style="{StaticResource WorkspaceResizeHandle}"
               PointerEntered="OnPreviewResizePointerEntered"
               PointerExited="OnPreviewResizePointerExited"
               DragDelta="OnPreviewDragDelta"
               KeyDown="OnPreviewResizeKeyDown" />

        <Grid Grid.Row="2"
              Padding="6"
              RowSpacing="5"
              ColumnSpacing="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="156" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="2.2*" />
                </Grid.ColumnDefinitions>

                <zones:ModeSelectorZone x:Name="ModeSelector" />
                <zones:NewEventZone x:Name="NewEvent"
                                    Grid.Column="1" />
                <zones:WordPreviewZone Grid.Column="2" />
            </Grid>

            <Grid Grid.Row="1"
                  LayoutUpdated="OnFormLayoutUpdated">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="FormScrollViewer"
                              HorizontalScrollBarVisibility="Hidden"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Disabled"
                              VerticalScrollMode="Disabled"
                              ViewChanged="OnFormViewChanged">
                    <Grid x:Name="FormSurface"
                          RowSpacing="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <zones:EventFormZone x:Name="EventForm"
                                             Layout="{Binding FormLayout}" />
                        <zones:CandidatesZone x:Name="Candidates"
                                              Grid.Row="1" />
                    </Grid>
                </ScrollViewer>
                <StackPanel x:Name="FormScrollButtons"
                            Grid.Row="1"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="Collapsed">
                    <Button x:Name="ScrollFormLeft"
                            Content="&#x2190;"
                            AllowFocusOnInteraction="False"
                            Click="OnScrollFormLeft" />
                    <Button x:Name="ScrollFormRight"
                            Content="&#x2192;"
                            AllowFocusOnInteraction="False"
                            Click="OnScrollFormRight" />
                </StackPanel>
            </Grid>
            <zones:WorkspaceActionsZone x:Name="WorkspaceActions"
                                        Grid.Column="1"
                                        Grid.RowSpan="2" />
        </Grid>
    </Grid>
</Page>
<Page x:Class="PersonalEventsBuilder.Pages.WorkspacePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:layout="using:UDK.WinUI.Layout"
      xmlns:views="using:PersonalEventsBuilder.Views"
      xmlns:grid="using:UDK.WinUI.Grid"
      Style="{StaticResource WorkspacePageStyle}"
      NavigationCacheMode="Required">
    <layout:WorkspaceHost x:Name="Workspace">
        <layout:WorkspaceHost.Resources>
            <grid:GridNavigation x:Key="EventNavigation" />
            <grid:GridAxis x:Key="EventColumns"
                           Step="116"
                           Count="24" />
            <grid:GridLayout x:Key="FormGrid"
                             Columns="{StaticResource EventColumns}"
                             Navigation="{StaticResource EventNavigation}">
                <grid:GridLayout.Rows>
                    <grid:GridAxis Step="40"
                                   Count="6" />
                </grid:GridLayout.Rows>
            </grid:GridLayout>
            <grid:GridLayout x:Key="CandidatesGrid"
                             NavigationOrder="1"
                             Columns="{StaticResource EventColumns}"
                             Navigation="{StaticResource EventNavigation}">
                <grid:GridLayout.Rows>
                    <grid:GridAxis Step="28"
                                   Count="30" />
                </grid:GridLayout.Rows>
            </grid:GridLayout>
            <Style TargetType="Thumb"
                   BasedOn="{StaticResource ZoneSplitterStyle}" />
            <Style TargetType="TextBlock"
                   BasedOn="{StaticResource ZoneLabelStyle}" />
        </layout:WorkspaceHost.Resources>
        <layout:Zone Direction="Columns">
            <layout:Zone Direction="Rows">
                <layout:Zone Size="194"
                             MinSize="48"
                             Direction="Columns">
                    <layout:Zone Size="1.44*"
                                 Style="{StaticResource ZonePanelStyle}">
                        <views:CommandPanel x:Name="Commands" />
                    </layout:Zone>
                    <layout:Splitter />
                    <layout:Zone Size="149"
                                 Style="{StaticResource ZonePanelStyle}">
                        <TextBlock Text="Новое событие" />
                    </layout:Zone>
                    <layout:Splitter />
                    <layout:Zone Size="*"
                                 Style="{StaticResource ZonePanelStyle}">
                        <TextBlock Text="Превью Word" />
                    </layout:Zone>
                </layout:Zone>
                <layout:Splitter />
                <layout:Zone MinSize="96"
                             Direction="Rows">
                    <layout:Zone Size="2*"
                                 Style="{StaticResource ZonePanelStyle}">
                        <views:EventForm GridLayout="{StaticResource FormGrid}" />
                    </layout:Zone>
                    <layout:Zone Size="*"
                                 Style="{StaticResource ZonePanelStyle}">
                        <TextBlock Text="Сводка" />
                    </layout:Zone>
                    <layout:Zone Size="3*"
                                 Direction="Columns">
                        <layout:Zone Size="160"
                                     MinSize="8"
                                     Style="{StaticResource ZonePanelStyle}" />
                        <layout:Splitter />
                        <layout:Zone MinSize="120"
                                     Style="{StaticResource ZonePanelStyle}">
                            <views:CandidatesTable GridLayout="{StaticResource CandidatesGrid}" />
                        </layout:Zone>
                        <layout:Splitter />
                        <layout:Zone Size="160"
                                     MinSize="40"
                                     Style="{StaticResource ZonePanelStyle}" />
                    </layout:Zone>
                </layout:Zone>
            </layout:Zone>
            <layout:Splitter />
            <layout:Zone Size="218"
                         MinSize="100"
                         Style="{StaticResource ZonePanelStyle}">
                <TextBlock Text="Действия" />
            </layout:Zone>
        </layout:Zone>
    </layout:WorkspaceHost>
</Page>
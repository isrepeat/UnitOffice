<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="Exists('C:\!PackagesFeed\Windows')">
    <RestorePackagesPath Condition="'$(RestorePackagesPath)' == ''">$(MSBuildThisFileDirectory)..\..\..\!artifacts\nuget\AscodInteropServer</RestorePackagesPath>
  </PropertyGroup>
  <PropertyGroup>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <OutDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\!artifacts\projects\Windows\msbuild\$(MSBuildProjectName)\bin\$(Platform)\$(Configuration)'))\</OutDir>
    <IntDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\!artifacts\projects\Windows\msbuild\$(MSBuildProjectName)\obj\$(Platform)\$(Configuration)'))\</IntDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="UniversalDevKit.Helpers" Version="[0.1.0]" />
    <PackageReference Include="UniversalDevKit.Diagnostic" Version="[0.1.0]" />
  </ItemGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Debug'">
    <ClCompile>
      <AdditionalOptions>/FC %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <AscodInteropServerWebAsset Include="$(MSBuildThisFileDirectory)Web\**\*" />
  </ItemGroup>
  <Target Name="CopyAscodInteropServerWebAssets" AfterTargets="Build">
    <Copy SourceFiles="@(AscodInteropServerWebAsset)"
          DestinationFiles="@(AscodInteropServerWebAsset->'$(TargetDir)Web\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
  </Target>
</Project>
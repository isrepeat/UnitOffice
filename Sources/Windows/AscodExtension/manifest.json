{
  "manifest_version": 3,
  "name": "AscodExtension",
  "version": "0.2.0",
  "description": "Records requests to a selected AscodSite server across Microsoft Edge tabs.",
  "permissions": [
    "scripting",
    "sidePanel",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Ascod API"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
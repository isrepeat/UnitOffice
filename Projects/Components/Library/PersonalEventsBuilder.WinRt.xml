<?xml version="1.0" encoding="utf-8"?>
<Component name="PersonalEventsBuilder.WinRt">
  <Projects>
    <Project id="winrt"
             kind="library"
             projectType="winrt">
      <Projection assemblyName="PersonalEventsBuilder.WinRt.Projection"
                  targetFramework="net10.0-windows10.0.26100.0" />
      <Files>
        <Input role="header">Sources/Windows/PersonalEventsBuilder.WinRt/**/*.h</Input>
        <Input role="source">Sources/Windows/PersonalEventsBuilder.WinRt/**/*.cpp</Input>
        <Input role="source">Sources/Windows/PersonalEventsBuilder.WinRt/**/*.idl</Input>
        <Group id="BuildFiles">
          <Ref tag="Output" id="Dependencies" />
        </Group>
      </Files>
      <Filters>
        <Filter filter="{Tree:Project}"
                preserveTree="true">
          <Match>Sources/Windows/PersonalEventsBuilder.WinRt/**/*</Match>
        </Filter>
        <Filter filter="{Tree:Project}/Build">
          <Ref tag="Group" id="BuildFiles" />
        </Filter>
      </Filters>
      <Requirements cxxStandard="20" />
      <Compile>
        <PrecompiledHeader>notUsing</PrecompiledHeader>
      </Compile>
      <Dependencies>
        <Dependency component="PersonalEventsBuilder.Core"
                    visibility="private"
                    linkage="static" />
      </Dependencies>
    </Project>
  </Projects>
</Component>